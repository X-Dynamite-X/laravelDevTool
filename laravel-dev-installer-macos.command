#!/bin/bash
# Laravel Dev installer for macOS: run with `bash laravel-dev-installer-macos.command`.
# The app is embedded below (base64 zip, SHA-256 checked). Installs or updates
# ~/Applications/Laravel Dev.app; nothing outside your home folder is touched.
set -euo pipefail

VERSION="2.0.0"
EXPECTED_SHA256="6074e238b7d93ab7dd9b9ed037f9b6e9b7e76f759347f9b95afe32857c1c78d3"
PKG_DIR_NAME="laravel-dev-2.0.0"

SUPPORT="$HOME/Library/Application Support/LaravelDev"
INSTALL_DIR="$SUPPORT/install"
APP="$INSTALL_DIR/app"
VENV="$INSTALL_DIR/venv"
BUNDLE="$HOME/Applications/Laravel Dev.app"

if [[ ${EUID:-$UID} -eq 0 ]]; then
  echo "Please run as your regular user, not with sudo."
  exit 1
fi

echo "Laravel Dev $VERSION for macOS"
echo

# 1. Python 3.10+ (the Command Line Tools' /usr/bin/python3 is 3.9, so look elsewhere first)
find_python() {
  local candidate
  for candidate in \
    /opt/homebrew/bin/python3.1{3,2,1,0} /usr/local/bin/python3.1{3,2,1,0} \
    /Library/Frameworks/Python.framework/Versions/3.1{3,2,1,0}/bin/python3 \
    /opt/homebrew/bin/python3 /usr/local/bin/python3 "$(command -v python3 || true)"; do
    if [[ -x "$candidate" ]] && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

PY="$(find_python || true)"
if [[ -z "$PY" ]]; then
  if command -v brew >/dev/null 2>&1; then
    answer=""
    read -r -p "Python 3.10+ is required. Install it now with Homebrew? [Y/n] " answer || true
    if [[ ! "$answer" =~ ^[nN] ]]; then
      brew install python@3.12
      PY="$(find_python || true)"
    fi
  fi
  if [[ -z "$PY" ]]; then
    open "https://www.python.org/downloads/macos/" || true
    echo "Python 3.10+ was not found. Install it from python.org (or: brew install python), then run this installer again."
    exit 1
  fi
fi
echo "Using $PY"

# 2. Payload
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT
"$PY" - "$0" "$TMP_DIR/payload.zip" "$EXPECTED_SHA256" <<'PY'
import base64, hashlib, sys
data = open(sys.argv[1], "rb").read()
marker = b"\n__PAYLOAD_" + b"BELOW__\n"
payload = base64.b64decode(data[data.index(marker) + len(marker):])
if hashlib.sha256(payload).hexdigest() != sys.argv[3]:
    sys.exit("Checksum verification failed. The installer may be corrupted or modified.")
open(sys.argv[2], "wb").write(payload)
PY
unzip -q "$TMP_DIR/payload.zip" -d "$TMP_DIR/extracted"
[[ -d "$TMP_DIR/extracted/$PKG_DIR_NAME" ]] || { echo "Invalid payload content."; exit 1; }

# 3. Files (the virtualenv is kept between updates)
pkill -f "$APP/ui/app.py" 2>/dev/null || true
echo "Installing into $INSTALL_DIR"
mkdir -p "$INSTALL_DIR"
rm -rf "$APP"
mv "$TMP_DIR/extracted/$PKG_DIR_NAME" "$APP"
chmod +x "$APP"/ui/*.sh

# 4. Python packages, in the app's own virtualenv (Homebrew's Python refuses `pip install --user`)
if [[ ! -x "$VENV/bin/python" ]]; then
  echo "Creating the Python environment..."
  "$PY" -m venv "$VENV"
fi
echo "Installing Python packages (pywebview, PyMySQL, psycopg)..."
"$VENV/bin/python" -m pip install --disable-pip-version-check -q --upgrade -r "$APP/requirements.txt"

# 5. The app bundle
rm -rf "$BUNDLE"
mkdir -p "$BUNDLE/Contents/MacOS" "$BUNDLE/Contents/Resources"
cat > "$BUNDLE/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>Laravel Dev</string>
  <key>CFBundleDisplayName</key><string>Laravel Dev</string>
  <key>CFBundleIdentifier</key><string>dev.laravel.LaravelDev</string>
  <key>CFBundleExecutable</key><string>laravel-dev</string>
  <key>CFBundleIconFile</key><string>laravel-dev</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$VERSION</string>
  <key>LSMinimumSystemVersion</key><string>10.15</string>
  <key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
cat > "$BUNDLE/Contents/MacOS/laravel-dev" <<LAUNCHER
#!/bin/bash
# Finder starts apps with a bare PATH: take the login shell's, so php, composer,
# node and git are found the same way as in Terminal.
LOGIN_PATH="\$("\${SHELL:-/bin/zsh}" -ilc 'printf "__LDPATH__%s" "\$PATH"' 2>/dev/null </dev/null)"
LOGIN_PATH="\${LOGIN_PATH##*__LDPATH__}"
export PATH="\${LOGIN_PATH:+\$LOGIN_PATH:}/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export LARAVEL_DEV_LAUNCHER="\$0"
exec "$VENV/bin/python" "$APP/ui/app.py" "\$@"
LAUNCHER
chmod +x "$BUNDLE/Contents/MacOS/laravel-dev"
cp "$APP/assets/laravel-dev.icns" "$BUNDLE/Contents/Resources/" 2>/dev/null || true

cat > "$INSTALL_DIR/uninstall.command" <<'UNINSTALL'
#!/bin/bash
SUPPORT="$HOME/Library/Application Support/LaravelDev"
pkill -f "$SUPPORT/install/app/ui/app.py" 2>/dev/null
rm -rf "$HOME/Applications/Laravel Dev.app" "$SUPPORT/install"
rm -f "$HOME/Library/LaunchAgents/dev.laravel.LaravelDev.plist"
echo "Laravel Dev was removed. Your settings are kept in $SUPPORT."
UNINSTALL
chmod +x "$INSTALL_DIR/uninstall.command"

echo
echo "Installed Laravel Dev $VERSION in ~/Applications (also in Launchpad and Spotlight)."
echo "Uninstall: bash \"$INSTALL_DIR/uninstall.command\""
open "$BUNDLE"
exit 0

__PAYLOAD_BELOW__

