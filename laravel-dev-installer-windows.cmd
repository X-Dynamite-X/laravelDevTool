@echo off
rem Laravel Dev installer for Windows: double-click to install or update.
rem The app is embedded below (base64 zip, SHA-256 checked); the PowerShell part does the work.
setlocal
set "LD_SELF=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText($env:LD_SELF); $a=$t.IndexOf('#'+'PS_BELOW'); $b=$t.IndexOf('__PAYLOAD'+'_BELOW__'); iex $t.Substring($a, $b-$a)"
if errorlevel 1 (
  echo.
  echo Installation failed.
  pause
  exit /b 1
)
timeout /t 5 >nul
exit /b 0

#PS_BELOW
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
$Version = '2.0.0'
$Expected = 'c946a4b905b8524b46e5a513f1132bba7f9b766bf73e189174d5b9641d8ae5e9'
$PkgName = 'laravel-dev-2.0.0'

$Dir = Join-Path $env:LOCALAPPDATA 'Programs\LaravelDev'
$App = Join-Path $Dir 'app'
$Venv = Join-Path $Dir 'venv'
$Pythonw = Join-Path $Venv 'Scripts\pythonw.exe'
$Script = Join-Path $App 'ui\app.py'

Write-Host "Laravel Dev $Version for Windows"
Write-Host ''

# 1. Payload
$text = [IO.File]::ReadAllText($env:LD_SELF)
$marker = '__PAYLOAD' + '_BELOW__'
$bytes = [Convert]::FromBase64String($text.Substring($text.IndexOf($marker) + $marker.Length).Trim())
$sha = [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($bytes)).Replace('-', '').ToLower()
if ($sha -ne $Expected) { throw 'Checksum verification failed. The installer may be corrupted or modified.' }

# 2. Python 3.10+ (newest supported first; pywebview's .NET bridge lags behind brand-new Pythons)
function Find-Python {
  $candidates = @('-3.13', '-3.12', '-3.11', '-3.10') | ForEach-Object { @{ Exe = 'py'; Args = @($_) } }
  $candidates += @{ Exe = 'py'; Args = @('-3') }, @{ Exe = 'python'; Args = @() }
  foreach ($c in $candidates) {
    if (-not (Get-Command $c.Exe -ErrorAction SilentlyContinue)) { continue }
    $pyArgs = $c.Args + @('-c', 'import sys; print(sys.version_info >= (3, 10))')
    $ok = & $c.Exe @pyArgs 2>$null
    if ($LASTEXITCODE -eq 0 -and $ok -eq 'True') { return $c }
  }
  return $null
}

$py = Find-Python
if (-not $py) {
  if (Get-Command winget -ErrorAction SilentlyContinue) {
    $answer = Read-Host 'Python 3.10+ is required. Install Python 3.12 now with winget? [Y/n]'
    if ($answer -notmatch '^[nN]') {
      winget install -e --id Python.Python.3.12 --scope user --accept-package-agreements --accept-source-agreements
      $env:Path = [Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' + [Environment]::GetEnvironmentVariable('Path', 'User')
      $py = Find-Python
    }
  }
  if (-not $py) {
    Start-Process 'https://www.python.org/downloads/windows/'
    throw 'Python 3.10+ was not found. Install it from python.org (tick "Add python.exe to PATH"), then run this installer again.'
  }
}

# 3. Files (the virtualenv is kept between updates)
Get-Process pythonw, python -ErrorAction SilentlyContinue | Where-Object { $_.Path -and $_.Path.StartsWith($Dir, 'OrdinalIgnoreCase') } | Stop-Process -Force
Write-Host "Installing into $Dir"
$tmp = Join-Path ([IO.Path]::GetTempPath()) ('laravel-dev-' + [Guid]::NewGuid())
New-Item -ItemType Directory -Path $tmp | Out-Null
try {
  $zip = Join-Path $tmp 'payload.zip'
  [IO.File]::WriteAllBytes($zip, $bytes)
  Expand-Archive -Path $zip -DestinationPath $tmp
  New-Item -ItemType Directory -Force -Path $Dir | Out-Null
  if (Test-Path $App) { Remove-Item -Recurse -Force $App }
  Move-Item (Join-Path $tmp $PkgName) $App
} finally {
  Remove-Item -Recurse -Force $tmp -ErrorAction SilentlyContinue
}

# 4. Python packages, in the app's own virtualenv
if (-not (Test-Path (Join-Path $Venv 'Scripts\python.exe'))) {
  Write-Host 'Creating the Python environment...'
  $pyArgs = $py.Args + @('-m', 'venv', $Venv)
  & $py.Exe @pyArgs
  if ($LASTEXITCODE -ne 0) { throw 'Could not create the Python environment.' }
}
Write-Host 'Installing Python packages (pywebview, PyMySQL, psycopg)...'
& (Join-Path $Venv 'Scripts\python.exe') -m pip install --disable-pip-version-check -q --upgrade -r (Join-Path $App 'requirements.txt')
if ($LASTEXITCODE -ne 0) { throw 'Could not install the Python packages.' }

# 5. Shortcuts, uninstaller and the "Installed apps" entry
$icon = Join-Path $App 'assets\laravel-dev.ico'
$shell = New-Object -ComObject WScript.Shell
$programs = [Environment]::GetFolderPath('Programs')
foreach ($folder in @($programs, [Environment]::GetFolderPath('Desktop'))) {
  $link = $shell.CreateShortcut((Join-Path $folder 'Laravel Dev.lnk'))
  $link.TargetPath = $Pythonw
  $link.Arguments = '"' + $Script + '"'
  $link.WorkingDirectory = $App
  $link.Description = 'Laravel Dev'
  if (Test-Path $icon) { $link.IconLocation = $icon }
  $link.Save()
}

$uninstall = Join-Path $Dir 'uninstall.ps1'
@'
$ErrorActionPreference = 'SilentlyContinue'
$Dir = Join-Path $env:LOCALAPPDATA 'Programs\LaravelDev'
Get-Process pythonw, python | Where-Object { $_.Path -and $_.Path.StartsWith($Dir, 'OrdinalIgnoreCase') } | Stop-Process -Force
Remove-Item (Join-Path ([Environment]::GetFolderPath('Programs')) 'Laravel Dev.lnk')
Remove-Item (Join-Path ([Environment]::GetFolderPath('Desktop')) 'Laravel Dev.lnk')
Remove-Item (Join-Path ([Environment]::GetFolderPath('Startup')) 'Laravel Dev.cmd')
Remove-Item -Recurse 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\LaravelDev'
Set-Location $env:TEMP
Remove-Item -Recurse -Force $Dir
Write-Host ('Laravel Dev was removed. Your settings are kept in ' + (Join-Path $env:APPDATA 'LaravelDev'))
'@ | Set-Content -Path $uninstall -Encoding UTF8

$key = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\LaravelDev'
New-Item -Path $key -Force | Out-Null
$entries = @{
  DisplayName = 'Laravel Dev'; DisplayVersion = $Version; Publisher = 'Laravel Dev'
  InstallLocation = $Dir; DisplayIcon = $icon
  UninstallString = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + $uninstall + '"'
}
foreach ($name in $entries.Keys) { Set-ItemProperty -Path $key -Name $name -Value $entries[$name] }
Set-ItemProperty -Path $key -Name NoModify -Value 1 -Type DWord
Set-ItemProperty -Path $key -Name NoRepair -Value 1 -Type DWord

Write-Host ''
Write-Host "Installed Laravel Dev $Version. Open it from the Start menu or the desktop shortcut."
Write-Host 'Uninstall from Settings > Apps > Installed apps.'
Start-Process -FilePath $Pythonw -ArgumentList ('"' + $Script + '"') -WorkingDirectory $App
exit 0

__PAYLOAD_BELOW__

